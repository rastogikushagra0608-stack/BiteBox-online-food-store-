{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BiteBox": ""
  },
  "BiteBox": {
    "Restaurant": { "Name": "BiteBox", "UtcOffsetMinutes": 330 },
    "Pricing": { "TaxRate": 0.05, "DeliveryFee": 40, "FreeDeliveryThreshold": 499, "MinimumOrderAmount": 99 },
    "Database": { "MigrateOnStartup": false },
    "Seed": { "Enabled": false },
    "Swagger": { "Enabled": false },
    "Cors": { "AllowedOrigins": [] },
    "AI": {
      "Provider": "Rules",
      "Claude": { "Model": "claude-opus-5-5", "TimeoutSeconds": 15 }
    }
  }
}
